<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Declare both localizations (English-first) so Siri registers the RU phrases
         too. The device's Siri language selects which phrase set is recognized. -->
    <key>CFBundleLocalizations</key>
    <array>
      <string>en</string>
      <string>ru</string>
    </array>
  </dict>
</plist>