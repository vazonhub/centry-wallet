# Copy to `.env` and fill in your own values. Every variable is optional:
# the app builds and runs without them (Centry is fully offline).
#
# Centry has NO network features — there are no API/ads/analytics keys.
# The only variables are for EAS cloud builds, and those are needed only
# from v1.0 (App Store), not for the local Build 0 installed via Xcode.

# --- EAS (cloud builds, v1.0+) ------------------------------------------
# Your Expo account/organization and EAS project id (`eas init` prints both).
# Also add these to your EAS project environment variables for cloud builds,
# since `.env` is not committed.
EXPO_OWNER=
EAS_PROJECT_ID=
